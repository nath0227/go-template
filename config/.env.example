# ── Server ──────────────────────────────────────
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=10s

# ── Logger ──────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── Database ─────────────────────────────────────
DB_BACKEND=gorm   # gorm | pgx | both
DB_DRIVER=postgres

# Writer (primary / read-write)
DB_WRITER_HOST=localhost:5432
DB_WRITER_USER=user
DB_WRITER_PASSWORD=pass
DB_WRITER_NAME=dbname
DB_WRITER_SSL_MODE=disable
DB_WRITER_APPLICATION_NAME=my-service-writer
DB_WRITER_SCHEMA=
DB_WRITER_TIMEZONE=UTC        # MySQL only

# Reader (replica / read-only) — omit DB_READER_HOST to fall back to writer
DB_READER_HOST=
DB_READER_USER=user
DB_READER_PASSWORD=pass
DB_READER_NAME=dbname
DB_READER_SSL_MODE=disable
DB_READER_APPLICATION_NAME=my-service-reader
DB_READER_SCHEMA=
DB_READER_TIMEZONE=UTC        # MySQL only

# Connection pool (shared between writer and reader)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ── Redis ────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# ── Kafka (shared) ───────────────────────────────
KAFKA_BROKERS=localhost:9092

# Auth: none | sasl_scram_512 | aws_msk
KAFKA_AUTH=none
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_AWS_REGION=ap-southeast-1   # only for aws_msk

# Producer
KAFKA_PRODUCER_TOPIC=product-events
KAFKA_PRODUCER_BATCH_SIZE=100
KAFKA_PRODUCER_BATCH_TIMEOUT=1ms

# Consumer
KAFKA_CONSUMER_TOPIC=product-commands
KAFKA_CONSUMER_GROUP_ID=product-service
KAFKA_CONSUMER_MIN_BYTES=1
KAFKA_CONSUMER_MAX_BYTES=10485760
KAFKA_CONSUMER_COMMIT_INTERVAL=1s

# ── Object Storage ───────────────────────────────
# Driver: aws | gcp | tencent
# For local development use MinIO (docker-compose): STORAGE_DRIVER=aws + STORAGE_ENDPOINT=http://localhost:9000
STORAGE_DRIVER=aws
STORAGE_REGION=us-east-1
STORAGE_BUCKET=my-bucket
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_CREDENTIALS_FILE=   # GCP service account JSON path
STORAGE_CDN_BASE_URL=

# ── HTTP Client ──────────────────────────────────
HTTP_CLIENT_TIMEOUT=30s
HTTP_CLIENT_MAX_IDLE_CONNS=100
HTTP_CLIENT_MAX_CONNS_PER_HOST=10
